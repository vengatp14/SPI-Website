# ==========================================================================
# SP International - Apache configuration (requires Apache 2.4 with mod_rewrite,
# mod_headers, mod_expires, mod_deflate). Every block is wrapped in <IfModule>
# so a missing module is skipped instead of causing a 500 error.
# NOT TESTED on a live server - see README.md ("Server configuration").
# ==========================================================================

# SEO: Error documents (root-relative: deploy in the web root, not a sub-folder)
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html

# Do not list directories; use UTF-8
Options -Indexes
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On

  # SEO: Force HTTPS (also honours a proxy/CDN that terminates TLS)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # SEO: Canonical host redirect - ENABLE after the production domain is confirmed.
  # Replace example.com (non-www -> www shown; reverse if you prefer non-www).
  # RewriteCond %{HTTP_HOST} !^www\.example\.com$ [NC]
  # RewriteRule ^ https://www.example.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Block developer/documentation files from being served publicly
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(md|log|bak|ini|sh)$|^README_UPDATED\.txt$)">
    Require all denied
  </FilesMatch>
  # robots.txt and the .well-known folder must stay reachable
  <FilesMatch "^\.htaccess$">
    Require all denied
  </FilesMatch>
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HSTS: uncomment only once HTTPS works for the domain and all subdomains you care about
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  # CSP is Report-Only on purpose: it has not been exercised in a real browser here.
  # Review the browser console, then rename to Content-Security-Policy to enforce.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; frame-src https://www.youtube-nocookie.com https://www.google.com; connect-src 'self' https://api.web3forms.com; base-uri 'self'; form-action 'self' https://api.web3forms.com; object-src 'none'"
</IfModule>

# Performance: compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain text/xml application/xml application/json application/manifest+json image/svg+xml
</IfModule>

# Performance: browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>
